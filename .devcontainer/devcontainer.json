{
    "name": "ROS2 Mujoco Project",
    "remoteUser": "user",
    "updateRemoteUserUID": true,
    "build": {
        "dockerfile": "Dockerfile"
    },
    "workspaceFolder": "/workspace",
    "containerEnv": {
        "HTTP_PROXY": "http://127.0.0.1:7890",
        "HTTPS_PROXY": "http://127.0.0.1:7890",
        "http_proxy": "http://127.0.0.1:7890",
        "https_proxy": "http://127.0.0.1:7890",
        "NO_PROXY": "localhost,127.0.0.1,::1",
        "no_proxy": "localhost,127.0.0.1,::1"
    },
    "mounts": [
        "source=${localWorkspaceFolder},target=/workspace,type=bind",
        "source=${localEnv:HOME}/.config/xiaomi-mimo/api_key,target=/home/user/.config/xiaomi-mimo/api_key,type=bind,readonly",
        "source=${localEnv:HOME}/.cc-switch,target=/home/user/.cc-switch,type=bind,readonly"
    ],
    "postStartCommand": "python3 /workspace/.devcontainer/configure-mimo-mcp.py && python3 /workspace/.devcontainer/configure-claude-code.py",
    "runArgs": [
        "--net=host",
        "--ipc=host",
        "--gpus=all",
        "-e", "DISPLAY=${localEnv:DISPLAY}",
        "-v", "/tmp/.X11-unix:/tmp/.X11-unix"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-iot.vscode-ros",
                "ms-python.python"
            ]
        }
    }
    // "postCreateCommand": "rosdep update"
}
