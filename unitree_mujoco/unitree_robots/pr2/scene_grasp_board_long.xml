<mujoco model="pr2_board_grasp_scene_long">
  <include file="robot_pr2_board_grasp.xml"/>
  <!-- Resolve finite friction contacts without increasing the friction coefficient. -->
  <option integrator="implicitfast" cone="elliptic" impratio="10" tolerance="1e-10"/>

  <asset>
    <texture type="skybox" file="meshes/desert.png" gridsize="3 4" gridlayout=".U..LFRB.D.." />
    <texture name="plane" type="2d" builtin="checker" rgb1=".2 .3 .4" rgb2=".3 .4 .5" width="512" height="512" mark="cross" markrgb=".8 .8 .8" />
    <material name="plane" reflectance="0.3" texture="plane" texrepeat="1 1" texuniform="true" />
    <material name="wood" rgba="0.6 0.4 0.2 1"/>
  </asset>

  <worldbody>
    <light directional="true" pos="0 0 30" dir="0 -0.5 -1"/>

    <geom name="floor" pos="0 0 0" size="0 0 .25" type="plane" material="plane" contype="7" conaffinity="15" condim="3" solref="0.001 0.01" solimp="0.9 0.95 0.001"/>

    <!--
      Long board (2.0 m × 0.10 m × 0.04 m) for human-robot co-transport.
      The board body position is the center; the gripper grasps ~1.0 m from the
      centre (the near end).  The free joint is intentional: board orientation
      must be generated by the applied endpoint wrench and the robot grasp,
      rather than being removed by XYZ-only slide joints.
    -->
    <!-- 60 mm insertion with the configured pre-grasp arm pose provides
         contact-patch clearance from the board end during S12 rotation. -->
    <body name="grasp_board" pos="-1.605000 1.350000 0.885729" quat="1 0 0 0">
      <freejoint name="board_free"/>
      <!-- Free board: the robot grasps it only through fingertip contact friction. -->
      <geom name="board_geom" type="box" size="1.0 0.050 0.020" mass="1.8" material="wood" contype="8" conaffinity="8" condim="4" friction="2.5 0.03 0.003" solref="0.004 1" solimp="0.90 0.99 0.001"/>
      <site name="board_center" type="sphere" size="0.015" rgba="0.9 0.1 0.1 1"/>
    </body>
  </worldbody>

  <sensor>
    <framepos name="board_pos" objtype="body" objname="grasp_board"/>
    <framequat name="board_quat" objtype="body" objname="grasp_board"/>
  </sensor>
</mujoco>
